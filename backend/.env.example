# HirED backend configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# Leave a key BLANK to run that feature for free: no ANTHROPIC_API_KEY -> heuristic
# extraction; no DEEPGRAM_API_KEY -> TTS/STT disabled. The first page works either way.

# --- Anthropic (Claude) — extraction + lesson generation (blank = free heuristic) ---
ANTHROPIC_API_KEY=

# --- Deepgram — TTS (Aura) + STT (Nova) (blank = voice disabled) ---
DEEPGRAM_API_KEY=

# --- Fetch.ai uAgents ---
# Paste the agent1q... addresses printed by each agent on startup.
# (uAgents auto-fund on testnet — no private key needed.)
RESOURCE_AGENT_ADDRESS=agent1q...
BENCHMARK_AGENT_ADDRESS=agent1q...

# --- Redis (optional; cache/queue). Backend degrades gracefully if absent. ---
REDIS_URL=redis://localhost:6379/0

# --- Server ---
# Public base URL the frontend uses to fetch narration audio files.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model selection — default to the CHEAP model to conserve credits.
#     Set CLAUDE_MODEL=claude-opus-4-8 for higher quality if budget allows. ---
CLAUDE_MODEL=claude-haiku-4-5-20251001
GEN_MODEL=claude-haiku-4-5-20251001

# --- Scoring engine: "deterministic" (default) or "custom" (teammate's scorer) ---
SCORER=deterministic

# --- TokenRouter — lightweight model gateway for 2AFC judging (OpenAI-compatible) ---
# Get your key at https://www.tokenrouter.com/ — drop it in here.
# TOKEN_ROUTER_BASE_URL defaults to https://api.tokenrouter.com/v1 (set to override).
# TOKEN_ROUTER_MODEL defaults to "auto" (let TokenRouter pick cheapest capable model).
TOKEN_ROUTER_API_KEY=
TOKEN_ROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKEN_ROUTER_MODEL=auto

# --- Sai: path to Sai's exported jobs/mentors JSON (blank = built-in demo seed) ---
SAI_DATA_PATH=
# Path to full JD text JSON produced by scripts/fetch_jds.py (blank = no JD context)
JD_DATA_PATH=
