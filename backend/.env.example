# HirED backend configuration. Copy to `.env` and fill in. NEVER commit `.env`.

# --- Anthropic (Claude) — extraction + lesson generation ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Deepgram — TTS (Aura) + STT (Nova) ---
DEEPGRAM_API_KEY=...

# --- Fetch.ai uAgents ---
# Paste the agent1q... addresses printed by each agent on startup.
# (uAgents auto-fund on testnet — no private key needed.)
RESOURCE_AGENT_ADDRESS=agent1q...
BENCHMARK_AGENT_ADDRESS=agent1q...

# --- Redis (optional; cache/queue). Backend degrades gracefully if absent. ---
REDIS_URL=redis://localhost:6379/0

# --- Server ---
# Public base URL the frontend uses to fetch narration audio files.
PUBLIC_BASE_URL=http://localhost:8000
# Comma-separated allowed CORS origins (frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model selection (override if needed) ---
CLAUDE_MODEL=claude-opus-4-8
